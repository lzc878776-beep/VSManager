<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net48</TargetFramework>
	<UseWindowsForms>true</UseWindowsForms>
	<LangVersion>latest</LangVersion>
	<AssemblyName>VSManager</AssemblyName>
	<RootNamespace>VSManager</RootNamespace>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>app.ico</ApplicationIcon>
	<Product>多 VS 管理工具</Product>
	<Version>1.0.0</Version>
	<GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
	<Reference Include="Microsoft.CSharp" />
	<Reference Include="UIAutomationClient" />
	<Reference Include="UIAutomationTypes" />
	<Reference Include="WindowsBase" />
	<Reference Include="System.Runtime.Serialization" />
	<Reference Include="System.Web.Extensions" />
	<Reference Include="System.Security" />
	<Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="Web\remote.html" />
	<EmbeddedResource Include="Web\transcript.html" />
	<EmbeddedResource Include="Skill\SKILL.md" />
	<EmbeddedResource Include="Skill\vsm.ps1" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Markdig" Version="1.4.0" />
	<PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
	<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

</Project>
