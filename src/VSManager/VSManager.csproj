<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net48</TargetFramework>
	<UseWindowsForms>true</UseWindowsForms>
	<LangVersion>latest</LangVersion>
	<AssemblyName>VSManager</AssemblyName>
	<RootNamespace>VSManager</RootNamespace>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	<Product>多 VS 管理工具</Product>
	<Version>1.0.0</Version>
	<GenerateDocumentationFile>false</GenerateDocumentationFile>
	<!-- 固定 x64，确保 e_sqlite3.dll 复制为与进程匹配的 x64 版本 / Match native e_sqlite3 bitness -->
	<PlatformTarget>x64</PlatformTarget>
	<Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
	<Reference Include="Microsoft.CSharp" />
	<Reference Include="UIAutomationClient" />
	<Reference Include="UIAutomationTypes" />
	<Reference Include="WindowsBase" />
	<Reference Include="System.Runtime.Serialization" />
	<Reference Include="System.Web.Extensions" />
	<Reference Include="System.Security" />
	<Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="Assets\Web\remote.html" LogicalName="VSManager.Web.remote.html" />
	<EmbeddedResource Include="Assets\Web\transcript.html" LogicalName="VSManager.Web.transcript.html" />
	<EmbeddedResource Include="Assets\Skill\SKILL.md" LogicalName="VSManager.Skill.SKILL.md" />
	<EmbeddedResource Include="Assets\Skill\vsm.ps1" LogicalName="VSManager.Skill.vsm.ps1" />
  </ItemGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="VSManager.Tests" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Markdig" Version="1.4.0" />
	<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
	<PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
	<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

</Project>
