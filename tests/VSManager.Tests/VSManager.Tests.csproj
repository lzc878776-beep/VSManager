<Project Sdk="Microsoft.NET.Sdk">

  <!-- VSManager 核心逻辑单元测试（MSTest）/ Unit tests for VSManager core logic (MSTest) -->
  <PropertyGroup>
	<TargetFramework>net48</TargetFramework>
	<LangVersion>latest</LangVersion>
	<UseWindowsForms>true</UseWindowsForms>
	<IsPackable>false</IsPackable>
	<IsTestProject>true</IsTestProject>
	<RootNamespace>VSManager.Tests</RootNamespace>
	<AssemblyName>VSManager.Tests</AssemblyName>
	<!-- 测试框架与 NAudio 引用的 Microsoft.Win32.Registry 版本不同，已选择与主程序一致的版本，屏蔽该提示 -->
	<!-- The test SDK and NAudio reference different Microsoft.Win32.Registry versions; the one used by the app is chosen -->
	<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- 测试范围（见 TestKind.cs）：NoPopup（默认，只运行完全不弹窗的测试）、UI（界面类）、Console（命令行类）、All（全部）；例如 dotnet test -p:TestScope=All。显式传入 filter 时以其为准。 -->
  <!-- Test scope (see TestKind.cs): NoPopup (default, only tests that never pop up), UI, Console or All; e.g. dotnet test -p:TestScope=All. An explicit filter takes precedence. -->
  <PropertyGroup>
	<TestScope Condition="'$(TestScope)' == ''">NoPopup</TestScope>
	<_TestScopeFilter Condition="'$(TestScope)' == 'NoPopup'">TestCategory!=UI&amp;TestCategory!=Console</_TestScopeFilter>
	<_TestScopeFilter Condition="'$(TestScope)' == 'UI'">TestCategory=UI</_TestScopeFilter>
	<_TestScopeFilter Condition="'$(TestScope)' == 'Console'">TestCategory=Console</_TestScopeFilter>
	<VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">$(_TestScopeFilter)</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
	<Reference Include="System.Runtime.Serialization" />
	<Reference Include="System.Net.Http" />
	<Reference Include="UIAutomationClient" />
	<Reference Include="UIAutomationTypes" />
	<Reference Include="WindowsBase" />
	<Reference Include="PresentationCore" />
	<Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
	<PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
	<PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\src\VSManager\VSManager.csproj" />
  </ItemGroup>

  <Target Name="CheckTestScope" BeforeTargets="VSTest">
	<Error Condition="'$(TestScope)' != 'NoPopup' and '$(TestScope)' != 'UI' and '$(TestScope)' != 'Console' and '$(TestScope)' != 'All'" Text="TestScope 只能是 NoPopup、UI、Console 或 All / TestScope must be NoPopup, UI, Console or All: $(TestScope)" />
  </Target>

</Project>